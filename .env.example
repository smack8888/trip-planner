# Copy this file to .env and fill in real values. .env is never committed.

# Hotel listings and prices (LiteAPI, https://www.liteapi.travel).
# Free account: copy the sandbox key from the dashboard.
LITEAPI_KEY=
# Your passport country, as a two-letter code (e.g. ES, GB, FR). Hotels can
# price differently depending on it, so LiteAPI requires it.
LITEAPI_GUEST_NATIONALITY=
# Optional. Currency for prices, three letters. EUR if left empty.
LITEAPI_CURRENCY=EUR

# Real routes on the itinerary (Transitous, https://transitous.org). Free, no key.
# Transitous asks every app to say how to reach its author, so put your
# project's public web address here (e.g. https://github.com/<you>/trip-planner).
# Leave it empty and the itinerary uses estimates instead.
TRANSITOUS_CONTACT=
